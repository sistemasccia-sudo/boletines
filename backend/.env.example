# ---------------------------------------------------------------
# Copia este archivo como `.env` y completa los valores.
# Nunca subas .env al repositorio.
# ---------------------------------------------------------------

# Entorno: local | production
APP_ENV=local

# Origen exacto del frontend habilitado para CORS.
# En desarrollo: http://localhost:5173 (Vite). En producción: la URL real del frontend.
CORS_ORIGIN=http://localhost:5173

# Base de datos MySQL existente (no modificar la estructura desde la app)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=skfxocap_erpccia
DB_USER=usuario
DB_PASS=clave
DB_CHARSET=utf8mb4

# JWT - access token corto.
# Genera una clave larga y aleatoria, p. ej.: openssl rand -hex 32
JWT_SECRET=cambia-esta-clave-por-una-larga-y-aleatoria
JWT_TTL_MINUTES=60

# Rate limiting del endpoint /auth/login
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_MINUTES=15

# Procesamiento de imagenes (usado desde la Fase 3)
IMAGE_MAX_WIDTH=1600
IMAGE_PORTADA_MAX_WIDTH=2000
IMAGE_THUMB_WIDTH=400
IMAGE_QUALITY=80
IMAGE_MAX_UPLOAD_MB=10
IMAGE_MAX_SOURCE_PX=12000
